{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@domain/*": ["./src/domain/*"],
      "@data/*": ["./src/data/*"],
      "@model/*": ["./src/model/*"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}
