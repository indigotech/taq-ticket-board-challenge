{
  "extends": "../../packages/tsconfig/base.tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#api": ["./src/api"],
      "#api/*": ["./src/api/*"],
      "#core": ["./src/core"],
      "#core/*": ["./src/core/*"],
      "#data": ["./src/data"],
      "#data/*": ["./src/data/*"],
      "#domain": ["./src/domain"],
      "#domain/*": ["./src/domain/*"],
      "#env": ["./src/env"],
      "#env/*": ["./src/env/*"],
      "#test": ["./test"],
      "#test/*": ["./test/*"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules"]
}
